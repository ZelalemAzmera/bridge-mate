# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: none (BM25 offline, default) | local (Ollama) | cloud (OpenAI/Gemini)
AI_PROVIDER=none

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Ollama (used when AI_PROVIDER=local) ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Cloud LLM (used when AI_PROVIDER=cloud) ───────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
EXPRESS_PORT=3000

# ── crawl4ai (optional Tier-1 scraper) ───────────────────────────────────────
CRAWL4AI_URL=http://localhost:11235/crawl
CRAWL4AI_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict in production: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*
