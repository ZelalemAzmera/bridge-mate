# ==============================================================================
# BridgeMate Environment Variables Configuration (.env.example)
# Digital Bridge Accessibility Hackathon 2026 - Track 3
# ==============================================================================

# Core App Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LANGUAGE="am"

# Database (Neon PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/bridgemate?sslmode=require"
USE_MEMORY_DB="false"

# Authentication (Clerk) - set to "mock" for zero-key local development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="mock"
CLERK_SECRET_KEY="mock"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/learn"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/learn"

# AI Model Providers
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
DEFAULT_AI_PROVIDER="groq"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""

# Cache & Ephemeral State (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
USE_MEMORY_REDIS="false"

# Real-Time Support Messaging (Ably)
NEXT_PUBLIC_ABLY_PUBLISHABLE_KEY=""
ABLY_API_KEY=""
USE_MOCK_ABLY="false"

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# WebRTC Screen Sharing (Daily.co)
DAILY_API_KEY=""
NEXT_PUBLIC_DAILY_DOMAIN=""

# Telephony & SMS Gateway (Ethiopia)
SMS_PROVIDER="mock"
SEND_ET_API_KEY=""
SEND_ET_SENDER_ID="BridgeMate"
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
